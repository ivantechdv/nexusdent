PORT=4000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dental_erp
# Obligatorio en producción (nunca usar change-me-in-production)
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
NODE_ENV=development

# Resend (email) — https://resend.com
# Sin API key: en dev la clave temporal se imprime en la consola del backend
RESEND_API_KEY=
EMAIL_FROM=NexusDent <onboarding@resend.dev>

# URL pública del API (enlaces Confirmar/Cancelar del recordatorio de cita)
API_PUBLIC_URL=http://localhost:4000

# Zona horaria de la clínica (fechas en mails y recordatorios)
CLINIC_TZ=America/Caracas

# Recordatorio de citas (email 2 días antes). 0 = off
APPOINTMENT_REMINDER_ENABLED=1
# Hora local en CLINIC_TZ / APPOINTMENT_REMINDER_TZ (default 9)
APPOINTMENT_REMINDER_HOUR=9
# Alias legacy (si no hay APPOINTMENT_REMINDER_HOUR)
# APPOINTMENT_REMINDER_HOUR_NY=9
# APPOINTMENT_REMINDER_TZ=America/Caracas
# Solo para pruebas: forzar una corrida al arrancar el API
# APPOINTMENT_REMINDER_RUN_ON_BOOT=1

# Uploads en disco (igual que CondomiLive)
# Carpeta relativa al cwd del backend: ./uploads
